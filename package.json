    "check:c5a2-pptx-image-output-reopen": "node scripts/check-c5a2-pptx-image-output-reopen.mjs",
    "check:c5b-pptx-shape-lifecycle-evidence": "node scripts/check-c5b-pptx-shape-lifecycle-audit.mjs",
    "check:c5b-pptx-shape-output-reopen": "node scripts/check-c5b-pptx-shape-output-reopen.mjs",
