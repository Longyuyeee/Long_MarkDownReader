{
  "name": "tauri-app",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "displayName": "Long编辑",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "benchmark:pdf-range": "node scripts/benchmark-pdf-range.mjs",
    "check:theme-contract": "node scripts/check-theme-contract.mjs",
    "check:format-contract": "node scripts/check-format-contract.mjs",
    "check:workbook-contract": "node scripts/check-workbook-contract.mjs",
    "check:xlsx-release-gate": "node scripts/check-xlsx-release-gate.mjs",
    "ci:check": "npm run build && npm run check:theme-contract && npm run check:format-contract && npm run check:workbook-contract && npm run check:xlsx-release-gate && npm run test:rust && npm run benchmark:pdf-range && npm run audit:prod",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-vue-next": "^0.575.0",
    "mermaid": "11.16.0",
    "naive-ui": "^2.43.2",
    "pdfjs-dist": "5.7.284",
    "pinia": "^3.0.4",
    "sass": "^1.97.3",
    "tesseract.js": "7.0.0",
    "vditor": "^3.11.2",
    "vfonts": "^0.0.3",
    "vue": "^3.5.13",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-static-copy": "^3.2.0",
    "vue-tsc": "^2.1.10"
  }
}
