    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "benchmark:pdf-range": "node scripts/benchmark-pdf-range.mjs",
    "audit:a5-desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-a5-desktop-audit.ps1",
    "audit:c3c2-pptx-locator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-c3c2-pptx-locator-audit.ps1",
