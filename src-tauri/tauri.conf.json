{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Long编辑",
  "version": "1.0.3",
  "identifier": "com.longyuye.mdreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:9000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Long编辑·md助手",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost misty-img: blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "LongEdit.Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "7bf71eea-e39f-54b9-a7e6-4922e93094a6",
        "language": ["zh-CN"]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRkJDOUM2RDFGNTM2N0YKUldSL052WFJ4c243Yys4N2JiOXF5c0RnN2pDUVY3Wk42RXFka3NBZWo5alIxYlg5VlNuYkE4WEsK",
      "endpoints": [
        "https://github.com/Longyuyeee/Long_MarkDownReader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
