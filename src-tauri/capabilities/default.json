{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "quick-note",
    "external-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/*.[pP][nN][gG]"
        },
        {
          "path": "**/*.[jJ][pP][gG]"
        },
        {
          "path": "**/*.[jJ][pP][eE][gG]"
        },
        {
          "path": "**/*.[gG][iI][fF]"
        },
        {
          "path": "**/*.[wW][eE][bB][pP]"
        },
        {
          "path": "**/*.[bB][mM][pP]"
        },
        {
          "path": "**/*.[iI][cC][oO]"
        },
        {
          "path": "**/*.[aA][vV][iI][fF]"
        },
        {
          "path": "**/*.[mM][pP]4"
        },
        {
          "path": "**/*.[wW][eE][bB][mM]"
        },
        {
          "path": "**/*.[oO][gG][vV]"
        },
        {
          "path": "**/*.[mM]4[vV]"
        },
        {
          "path": "**/*.[mM][oO][vV]"
        },
        {
          "path": "**/*.[mM][kK][vV]"
        },
        {
          "path": "**/*.[aA][vV][iI]"
        },
        {
          "path": "**/*.[mM][pP][eE][gG]"
        },
        {
          "path": "**/*.[mM][pP][gG]"
        }
      ]
    },
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "core:path:default",
    "os:default",
    "process:allow-restart",
    "updater:default",
    "autostart:default"
  ]
}
