{
  "schemaVersion": 1,
  "status": "implemented-for-next-package",
  "repository": "Longyuyeee/Long_MarkDownReader",
  "platform": "windows-x86_64",
  "automaticCheckIntervalHours": 24,
  "manualCheckAvailable": true,
  "userConfirmationRequired": true,
  "installerMode": "nsis-silent-overwrite",
  "installerNamePattern": "LongEdit_<version>_x64-setup.exe",
  "integrity": {
    "source": "github-release-asset-digest",
    "algorithm": "sha256",
    "missingDigestAction": "reject",
    "mismatchAction": "reject"
  },
  "trustBoundary": {
    "api": "https://api.github.com/repos/Longyuyeee/Long_MarkDownReader/releases/latest",
    "downloadHost": "github.com",
    "downloadPathPrefix": "/Longyuyeee/Long_MarkDownReader/releases/download/",
    "draftsAllowed": false,
    "prereleasesAllowed": false,
    "maximumInstallerBytes": 262144000
  },
  "legacyTauriUpdater": {
    "enabled": false,
    "reason": "original-private-key-unavailable",
    "latestJsonRequired": false
  },
  "migration": {
    "v1_0_4CanSelfUpgrade": false,
    "firstManagedUpdaterBuildRequiresManualInstallation": true,
    "subsequentSupportedBuildsCanAutoUpdate": true
  }
}
