{
  "schemaVersion": 1,
  "stage": "R3",
  "releaseCandidate": false,
  "scope": "local-index-backup-diagnostics",
  "phases": [
    {
      "id": "R3A",
      "label": "知识索引健康与恢复",
      "status": "implemented",
      "capabilities": [
        "queryable-index-state",
        "corrupt-snapshot-detection",
        "corrupt-snapshot-quarantine",
        "stale-source-count",
        "safe-rebuild-after-quarantine"
      ],
      "privacyBoundary": "索引恢复只移动本机缓存快照，不读取、导出或打包知识库正文。"
    },
    {
      "id": "R3B",
      "label": "配置与元数据备份导出",
      "status": "implemented",
      "capabilities": [
        "versioned-backup-manifest",
        "settings-export",
        "library-metadata-export",
        "capability-contract-export",
        "content-exclusion-by-default",
        "path-and-remote-fingerprints"
      ],
      "privacyBoundary": "备份包默认不包含外部知识库正文、系统凭据、API Key、完整用户路径或可恢复缓存正文。"
    },
    {
      "id": "R3C",
      "label": "备份导入预检与可迁移恢复",
      "status": "implemented",
      "capabilities": [
        "backup-preflight",
        "version-compatibility-check",
        "fixed-entry-allowlist",
        "manifest-digest-verification",
        "library-path-remapping",
        "credential-exclusion-on-restore",
        "reliable-config-restore"
      ],
      "privacyBoundary": "导入恢复只接受脱敏管理备份；旧机器绝对路径不会被恢复，知识库目录必须由用户在当前机器重新映射。"
    },
    {
      "id": "R3D",
      "label": "隐私净化诊断包",
      "status": "implemented",
      "capabilities": [
        "redacted-environment-report",
        "capability-contract-snapshot",
        "index-state-summary",
        "error-category-summary",
        "leakage-rejection-tests",
        "fixed-diagnostic-bundle-manifest",
        "credential-and-path-exclusion"
      ],
      "privacyBoundary": "诊断包只允许脱敏环境、版本、能力合同、索引状态和错误分类。"
    }
  ],
  "forbiddenByDefault": [
    "document-body",
    "api-key",
    "system-credential",
    "absolute-user-path",
    "recoverable-cache-body",
    "external-library-content"
  ],
  "nextStage": "R4"
}
