{
  "schemaVersion": 1,
  "stage": "R2",
  "appVersion": "1.0.17",
  "releaseCandidate": false,
  "formatRegistrySchemaVersion": 2,
  "profiles": [
    {
      "id": "local-overwrite",
      "dependency": "none",
      "sourcePolicy": "受签名冲突保护的原文件保存",
      "privacyBoundary": "内容仅在本机工作区处理",
      "knownLimitations": ["仅开放注册表声明的编辑能力，不提供外部运行时或语言服务"]
    },
    {
      "id": "protected-local-overwrite",
      "dependency": "none",
      "sourcePolicy": "显式解锁后受签名冲突保护保存",
      "privacyBoundary": "敏感值默认遮罩，并排除索引、知识图谱与遥测",
      "knownLimitations": ["敏感内容必须逐文件显式显示后才能编辑"]
    },
    {
      "id": "lightweight-source",
      "dependency": "none",
      "sourcePolicy": "仅在用户点击保存后，以签名冲突保护覆盖原文件",
      "privacyBoundary": "内容仅在本机工作区处理",
      "knownLimitations": ["补全和诊断仅覆盖语言关键字、HTML 标签、当前文档词及轻量源码问题，不包含编译、执行、调试、数据库连接或语言服务；HTML 安全预览不运行脚本或加载外部资源"]
    },
    {
      "id": "professional-log",
      "dependency": "none",
      "sourcePolicy": "查看模式只读；显式编辑模式以签名冲突保护覆盖源日志",
      "privacyBoundary": "日志内容仅在本机读取、筛选和编辑",
      "knownLimitations": ["编辑模式限制为 8 MiB；进入编辑会暂停自动刷新和尾部跟随；不提供并发日志合并"]
    },
    {
      "id": "pdf-copy",
      "dependency": "none",
      "sourcePolicy": "PDF 原文永不覆盖；批注与 OCR 写入 sidecar，页面操作、表单安全子集、永久脱敏、文字水印和文档属性只生成经复读验证的新副本",
      "privacyBoundary": "正文、批注与 OCR 数据保持本地",
      "knownLimitations": ["不提供 PDF 正文等价重排；表单填写仅支持已验证的单行文本、复选框、单选组和单选 Choice；自由输入或多选 Choice、复杂按钮、签名、加密、XFA 和主动内容保持阻断；永久脱敏输出为失去搜索与交互能力的图片型副本"]
    },
    {
      "id": "office-copy",
      "dependency": "none",
      "sourcePolicy": "DOCX/PPTX 经事务预览、签名校验和用户确认后可回滚保护覆盖；PPTX 单项草稿、ODS 有界单元格值/已有命名样式与 ODP 简单页直接正文编辑可可靠另存新副本",
      "privacyBoundary": "解析、索引和副本生成均在本机完成",
      "knownLimitations": ["DOCX/PPTX/ODS/ODP 仅开放经过真实生产者复开的基础编辑子集；ODS 公式、合并、重复和复杂内容保持只读，ODP 备注、复杂对象页及高级演示效果保持只读"]
    },
    {
      "id": "odf-preview",
      "dependency": "none",
      "sourcePolicy": "源文件只读，不提供保存",
      "privacyBoundary": "解析与索引均在本机完成，外部链接不跟随",
      "knownLimitations": ["不计算公式、不执行脚本、不还原复杂演示效果"]
    },
    {
      "id": "legacy-conversion",
      "dependency": "compatible-office-suite",
      "sourcePolicy": "源文件只读，仅允许用户指定不存在的新格式目标",
      "privacyBoundary": "转换使用隔离目录，源文件与既有目标不覆盖",
      "knownLimitations": ["LongEdit 不编辑旧二进制正文；转换结果取决于本机兼容 Office 应用"]
    },
    {
      "id": "wps-external",
      "dependency": "compatible-desktop-application",
      "sourcePolicy": "源文件只读，由用户确认后交给外部应用",
      "privacyBoundary": "LongEdit 仅读取容器身份与安全元数据",
      "knownLimitations": ["不解析正文、不索引、不转换、不写回"]
    },
    {
      "id": "workbook-bounded",
      "dependency": "none",
      "sourcePolicy": "仅经验证的 XLSX 子集允许带冲突保护的有限写回",
      "privacyBoundary": "工作簿解析、计算预览与保存均在本机完成",
      "knownLimitations": ["数组公式、外部链接和未验证高级对象保持只读或阻断写回"]
    },
    {
      "id": "media-preview",
      "dependency": "none",
      "sourcePolicy": "图片源文件只读且仅允许在资料库内另存编辑副本；视频和外部媒体不提供写回",
      "privacyBoundary": "媒体字节只在本机读取和处理，不上传、不索引；图片输出必须通过有界解码、摘要校验和复读",
      "knownLimitations": ["图片查看支持光标锚定滚轮缩放、拖拽平移和双击切换 100%/适应窗口；基础编辑限 PNG/JPEG/WebP/BMP 的旋转、翻转、精确裁剪、缩放、亮度/对比度/饱和度和格式转换，不提供图层、蒙版或专业色彩管理；GIF/ICO/AVIF 只读；资料库视频支持前后逐帧、原尺寸 PNG 截图、位置记忆和同目录同名 VTT/SRT 字幕，播放仍取决于系统 WebView 编解码器，不提供嵌入字幕拆封、字幕编辑或转码"]
    }
  ],
