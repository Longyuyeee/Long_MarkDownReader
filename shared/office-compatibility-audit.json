    {
      "id": "microsoft-office-automation",
      "disposition": "not-selected",
      "distribution": "user-installed",
      "license": "proprietary",
      "bundleImpact": "not-bundled",
      "scope": [".doc", ".xls", ".ppt"],
      "notes": "Useful as a fixture producer and reopen oracle, but unsuitable as the first unattended conversion dependency."
    },
    {
      "id": "wps-private-cli",
      "disposition": "blocked-undocumented-contract",
      "distribution": "user-installed",
      "license": "proprietary",
      "bundleImpact": "not-bundled; local installation measured at 1375.6 MiB",
      "scope": [".wps", ".et", ".dps"],
      "notes": "Local executables exist, but E0 found no public stable conversion CLI contract. They must not be invoked by product code without a separately qualified contract."
