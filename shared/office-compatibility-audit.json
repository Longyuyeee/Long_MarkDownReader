      "license": "MPL-2.0 and component licenses",
      "bundleImpact": "not-bundled; local installation measured at 662.8 MiB",
      "scope": [".odt", ".ods", ".odp", ".doc", ".xls", ".ppt"],
      "notes": "Discovery must use registry, executable probing or an explicit user-selected path. Conversion requires an isolated profile, timeout, output allowlist and structural reopen."
