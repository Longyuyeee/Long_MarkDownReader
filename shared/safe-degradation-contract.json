{
  "schemaVersion": 1,
  "stage": "D2",
  "appVersion": "1.0.12",
  "formatRegistrySchemaVersion": 2,
  "lanes": [
    {
      "id": "signature-protected-overwrite",
      "formats": [
        "markdown", "plain-text", "env", "ini", "properties", "editorconfig",
        "gitignore", "javascript", "typescript", "python", "rust", "go",
        "jvm-code", "c-family", "shell", "sql", "web-source", "json", "jsonc",
        "yaml", "xml", "svg", "drawio", "toml", "canvas", "table", "diagram", "opml", "log"
      ],
      "saveModes": ["overwrite"],
      "profiles": ["local-overwrite", "protected-local-overwrite", "lightweight-source", "professional-log"],
      "sourcePolicy": "signature-protected-write",
      "failurePolicy": "reject-stale-source-and-retain-draft",
      "evidence": [
        {
          "path": "src-tauri/src/commands/formats.rs",
          "markers": ["verify_current_signature", "expected_signature"]
        },
        {
          "path": "src-tauri/src/commands/json.rs",
          "markers": ["rejects_stale_signatures", "external-modified"]
        },
        {
          "path": "src/views/TextEditorView.vue",
          "markers": ["expectedSignature", "dirty.value = true"]
        },
        {
          "path": "src/views/LogViewerView.vue",
          "markers": ["write_log_document", "acknowledgedOverwrite", "dirty.value = true"]
        },
        {
          "path": "src-tauri/src/commands/svg.rs",
          "markers": ["unsafe-svg-save-blocked", "expected_signature"]
        },
        {
          "path": "src-tauri/src/commands/drawio.rs",
          "markers": ["unsafe-drawio-save-blocked", "expected_signature"]
        }
      ]
    },
    {
      "id": "strict-readonly-preview",
      "formats": ["ods", "odp", "video"],
      "saveModes": ["none"],
      "profiles": ["odf-preview", "media-preview"],
      "sourcePolicy": "never-write-source",
      "failurePolicy": "stop-preview-on-source-change",
      "evidence": [
        {
          "path": "src-tauri/src/commands/odf_content.rs",
          "markers": ["read_only: true", "source_preserved", "before == after"]
        },
        {
          "path": "shared/file-formats.json",
          "markers": ["\"id\": \"ods\"", "\"id\": \"odp\""]
        },
        {
          "path": "src-tauri/src/commands/media.rs",
          "markers": ["WorkspaceGuard::new(library_root)", "asset_protocol_scope", "read_only: true"]
        }
      ]
    },
    {
      "id": "verified-image-copy",
      "formats": ["raster-image"],
      "saveModes": ["copy"],
      "profiles": ["media-preview"],
      "sourcePolicy": "never-write-source-copy-only",
      "failurePolicy": "reject-stale-source-or-unverified-output",
      "evidence": [
        {
          "path": "src-tauri/src/commands/media.rs",
          "markers": ["expected_source_digest", "write_new_bytes", "source_unchanged: true", "target_reopened: true"]
        },
        {
          "path": "src-tauri/src/formats/raster_image.rs",
          "markers": ["MAX_IMAGE_PIXELS", "reader.limits(limits)", "结构复读尺寸"]
        }
      ]
    },
    {
      "id": "pdf-reliable-copy-isolation",
      "formats": ["pdf"],
      "saveModes": ["copy"],
      "profiles": ["pdf-copy"],
      "sourcePolicy": "never-overwrite-source-sidecars-and-new-copies-only",
      "failurePolicy": "reject-stale-source-existing-target-or-unverified-copy",
      "evidence": [
        {
          "path": "src-tauri/src/commands/pdf.rs",
          "markers": ["write_pdf_annotations", "write_pdf_ocr", "source_unchanged", "target_path.exists()"]
        },
        {
          "path": "src/views/PdfView.vue",
          "markers": ["loaded.source.fingerprint !== fingerprint", "!saved.sourceUnchanged"]
        }
      ]
    },
    {
      "id": "verified-office-copy",
      "formats": ["pptx"],
      "saveModes": ["copy"],
      "profiles": ["office-copy"],
      "sourcePolicy": "never-overwrite-source",
      "failurePolicy": "reject-stale-or-existing-target-and-remove-unverified-copy",
      "evidence": [
        {
          "path": "src-tauri/src/commands/pptx.rs",
          "markers": ["target_path.exists()", "source_signature != expected_signature", "remove_created_pptx_if_exact", "source_unchanged: true"]
        },
        {
          "path": "src/views/PptxReaderView.vue",
          "markers": ["expectedSignature", "saved.saveMode !== 'copy'"]
        }
      ]
    },
    {
      "id": "external-application-handoff",
      "formats": [
        "legacy-doc", "legacy-xls", "legacy-ppt", "wps-document",
        "wps-spreadsheet", "wps-presentation"
      ],
      "saveModes": ["none"],
      "profiles": ["legacy-conversion", "wps-external"],
      "sourcePolicy": "never-write-source",
      "failurePolicy": "require-explicit-application-or-new-conversion-target",
      "evidence": [
        {
          "path": "src-tauri/src/commands/external_apps.rs",
          "markers": ["open_workspace_file_externally", "source_preserved_at_handoff"]
        },
        {
          "path": "src-tauri/src/commands/legacy_office.rs",
          "markers": ["if target.exists()", "IsolatedConversionWorkspace::create"]
        },
        {
          "path": "src-tauri/src/commands/legacy_binary_office.rs",
          "markers": ["if target.exists()", "IsolatedConversionWorkspace::create"]
        },
        {
          "path": "src/views/LibraryMode.vue",
          "markers": ["external-open:system-default", "openFileExternally"]
        }
      ]
    },
    {
      "id": "bounded-structured-write",
      "formats": ["docx", "workbook"],
      "saveModes": ["bounded-overwrite"],
      "profiles": ["office-copy", "workbook-bounded"],
      "sourcePolicy": "signature-protected-bounded-write",
      "failurePolicy": "reject-stale-or-unsupported-advanced-object",
      "evidence": [
        {
          "path": "src-tauri/src/commands/docx.rs",
          "markers": ["save_docx_patch_source_to_path", "source_signature != expected_signature", "rollback_protected: true"]
        },
        {
          "path": "src/views/DocxReaderView.vue",
          "markers": ["save_docx_patch_source", "saved.rollbackProtected", "覆盖当前 DOCX？"]
        },
        {
          "path": "src-tauri/src/commands/workbook.rs",
          "markers": ["payload.expected_signature", "source_unchanged: true", "external_data"]
        },
        {
          "path": "scripts/check-workbook-contract.mjs",
          "markers": ["expectedSignature", "array"]
        }
      ]
    }
  ]
}
